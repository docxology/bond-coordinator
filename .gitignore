.coverage
.coverage.*
.pytest_cache/
__pycache__/
*.pyc
.benchmarks/
.mypy_cache/
.ruff_cache/

# Egg-info from local installs (any location — guards against renamed-fork drift).
**/*.egg-info/

# Project-local virtualenvs (root .venv is shared)
.venv/

# Generated artifacts — always regenerated from src/ + config (never hand-edited).
output/

# build artifacts (setuptools/uv path-dep builds)
build/

# Build output the vendored copies' own builds write into vendor/.
vendor/**/build/
